; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cloudline: The Sky Circuit"
config/description="A little yellow robot takes itself apart to reconnect a broken sky."
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.52157, 0.81961, 0.99216, 1)
config/icon="res://icon.svg"

[autoload]

Audio="*res://scenes/core/audio.tscn"
Campaign="*res://scripts/core/campaign.gd"
ScreenTransition="*res://scenes/core/screen_transition.tscn"
DebugPanel="*res://scenes/core/debug_panel.tscn"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://ui/cloudline_theme.tres"
theme/custom_font="res://assets/cloudline/fonts/NunitoSans-Variable.ttf"

