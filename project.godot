[layer_names]

3d_render/layer_20="exempt_from_paint"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemy_body"
3d_physics/layer_4="enemy_hurt"
3d_physics/layer_5="head_attack"
3d_physics/layer_6="pickup"
3d_physics/layer_7="puzzle_trigger"
3d_physics/layer_8="cargo"
3d_physics/layer_9="enemy_attack"
3d_physics/layer_10="platform_rider"

[physics]

common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"
3d/default_gravity=20.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="mobile"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.52157, 0.81961, 0.99216, 1)

